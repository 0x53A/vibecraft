{
  "name": "vibecraft",
  "version": "0.1.15",
  "description": "3D visualization of Claude Code as an interactive workshop",
  "author": "nearcyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nearcyan/vibecraft"
  },
  "keywords": [
    "claude",
    "claude-code",
    "visualization",
    "3d",
    "vibecoding",
    "ai",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "vibecraft": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "hooks/",
    "dist/",
    "!dist/**/*.map",
    "data/.gitkeep"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --kill-signal SIGTERM \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "cd server && cargo watch -x 'run -p vibecraft-server'",
    "build:terminal": "cd terminal-component && RUSTFLAGS='' wasm-pack build --target web",
    "dev:terminal": "cd terminal-component && RUSTFLAGS='' wasm-pack build --target web --dev",
    "dev:server:legacy": "tsx watch server_legacy/index.ts",
    "build": "pnpm run build:terminal && pnpm run build:client && pnpm run build:server",
    "build:client": "tsc && vite build",
    "build:server": "cargo build -C server --release -p vibecraft-server",
    "preview": "vite preview",
    "server": "cargo run -C server -p vibecraft-server",
    "server:legacy": "tsx server_legacy/index.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "deploy": "./scripts/deploy.sh",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "chokidar": "^4.0.0",
    "three": "^0.170.0",
    "tone": "^15.1.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
